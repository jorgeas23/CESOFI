DATABASE_URL="postgresql://user:password@host:5432/postgres"
JWT_SECRET="reemplaza-con-una-cadena-larga-y-aleatoria"
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SECRET_KEY="tu-service-role-key-de-supabase"
SUPABASE_EVIDENCE_BUCKET="evidencias"
PORT=4000

# Lista separada por comas de orígenes permitidos (ej. "https://app.cesofi.mx,https://admin.cesofi.mx").
# Sin definir, el backend acepta cualquier origen (solo recomendado en desarrollo).
CORS_ORIGIN=*
