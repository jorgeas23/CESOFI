DATABASE_URL="postgresql://user:password@host:5432/postgres"
JWT_SECRET="reemplaza-con-una-cadena-larga-y-aleatoria"
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SECRET_KEY="tu-service-role-key-de-supabase"
SUPABASE_EVIDENCE_BUCKET="evidencias"
PORT=4000

# Lista separada por comas de orígenes permitidos (ej. "https://app.cesofi.mx,https://admin.cesofi.mx").
# Sin definir, el backend acepta cualquier origen (solo recomendado en desarrollo).
CORS_ORIGIN=*

# API externa del Sistema de Diagnóstico Financiero (SIDEC). Debe ser una URL alcanzable
# desde donde corra este backend (no una IP de red local si el backend está en la nube).
# Sin configurar, /api/ruta y el registro por folio responden "no configurado" sin tumbar el servidor.
DIAGNOSTICO_API_URL="https://sidec.ejemplo.mx"
DIAGNOSTICO_API_KEY="tu-x-api-key-de-sidec"

# Llave que SIDEC debe mandar como X-API-Key al empujarnos un caso (POST /api/externo/casos).
# La generamos nosotros y se la damos a ellos — no es la misma que DIAGNOSTICO_API_KEY.
RECEPTOR_API_KEY="genera-una-llave-larga-y-aleatoria"
